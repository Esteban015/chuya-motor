# Chuya Motor â€” variables de entorno de ejemplo
# CopiÃ¡ este archivo como .env.local para desarrollo local
# NUNCA commitear .env.local ni archivos con credenciales reales

# Entorno de ejecuciÃ³n
NODE_ENV=development

# Observabilidad (Ajuste C â€” DECISIONS.md)
# Nunca activar TRACE_VERBOSE=true en entornos accesibles pÃºblicamente
TRACE_VERBOSE=false

# Proveedor LLM (stub = sin llamadas reales, para demo y tests)
LLM_PROVIDER=stub
# LLM_PROVIDER=anthropic  â† activar con clave real; requiere LLM_API_KEY

# Clave del proveedor LLM (solo si LLM_PROVIDER=anthropic)
# LLM_API_KEY=sk-ant-...
# Modelo Anthropic opcional (default: claude-haiku-4-5-20251001)
# LLM_MODEL=claude-haiku-4-5-20251001

# URL base para Playwright E2E (no cambiar salvo que uses puerto diferente)
PLAYWRIGHT_BASE_URL=http://localhost:3000

# --- Gemini (Google AI Studio) ------------------------------------------------
# Proveedor gratuito para demos. Usar AI Studio key (no GCP con billing).
# Modelo por defecto: gemini-3.5-flash-lite
#   HTTP 200 en generateContent confirmado para proyectos nuevos de AI Studio.
# Referencia de cuota free-tier: https://ai.google.dev/gemini-api/docs/rate-limits
# Privacidad: AI Studio free-tier puede usar datos para mejorar modelos de Google.
#   Usar solo datos sinteticos. Ver: https://ai.google.dev/gemini-api/terms

# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIza...          <- clave de https://aistudio.google.com/
# GEMINI_MODEL=gemini-3.5-flash-lite   <- modelo por defecto; override aqui si necesario
# GEMINI_FREE_TIER=true          <- 'false' deshabilita la allowlist y limites locales

# --- Groq (GroqCloud) -- SOLO EVALUACION, NO PRODUCCION (Incremento 6.3) -------
# Clave: https://console.groq.com/keys  (server-side; nunca NEXT_PUBLIC_*)
# Limites gratuitos: dependen de la cuenta -> https://console.groq.com/settings/limits
# Privacidad: usar solo datos sinteticos en pruebas.
# Pruebas reales: GROQ_REAL_LLM_AUTHORIZED=true como variable de SESION (aqui se ignora).

# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b     <- por defecto; tambien openai/gpt-oss-20b
# GROQ_MAX_TOKENS=2048               <- incluye reasoning tokens
# GROQ_TIMEOUT_MS=30000
# GROQ_REASONING_EFFORT=low
# GROQ_MAX_RETRIES=0

# --- Proteccion LLM (Incremento 6.4D) -- server-side, ver docs/reviews/groq-production-readiness-6.4d.md ---
# Almacen de cuotas compartido. En produccion, un proveedor real (groq/gemini/anthropic) SIN
# almacen distribuido no llama al LLM (falla cerrado). El stub nunca se bloquea por estas cuotas.
# LLM_QUOTA_STORE=upstash            <- upstash | memory | none (default: upstash si hay URL+TOKEN, si no memory)
# UPSTASH_REDIS_REST_URL=https://<db>.upstash.io   <- o KV_REST_API_URL (integracion de Vercel)
# UPSTASH_REDIS_REST_TOKEN=<token>                  <- o KV_REST_API_TOKEN. Nunca NEXT_PUBLIC_*
# LLM_QUOTA_KEY_PREFIX=chuya
# Limite anti-abuso por cliente (todas las solicitudes, incluido el stub y las bloqueadas)
# RATE_LIMIT_PER_WINDOW=10
# RATE_LIMIT_WINDOW_SECONDS=60
# CLIENT_IP_HEADER=x-forwarded-for   <- en Vercel la plataforma fija este header
# TRUSTED_PROXY_HOPS=1               <- toma la direccion agregada por el proxy confiable (derecha)
# CLIENT_ID_SALT=<valor aleatorio>   <- las IP nunca se guardan; solo un hash con sal
# Limites del piloto publico (6.4E). Los valores mostrados son los DEFAULTS del codigo
# (PILOT_LIMITS en protection-config.ts); solo hace falta definirlos para cambiarlos.
# Un "analisis" es un POST /api/analyze que llega al LLM real (las consultas bloqueadas no cuentan).
# Por visitante (IP con hash):
# LLM_CLIENT_ANALYSES_PER_WINDOW=3
# LLM_CLIENT_WINDOW_SECONDS=3600
# LLM_CLIENT_DAILY_ANALYSES=10      <- un visitante no puede agotar el cupo global
# Globales (por dia UTC, compartidos entre instancias):
# LLM_DAILY_ANALYSIS_BUDGET=40
# LLM_DAILY_CALL_BUDGET=80          <- 40 analisis x 2 llamadas
# LLM_DAILY_TOKEN_BUDGET=60000
# LLM_MAX_CALLS_PER_ANALYSIS=2
# LLM_MAX_CONCURRENT=2
# LLM_COOLDOWN_SECONDS_ON_429=60
# LLM_COOLDOWN_SECONDS_ON_5XX=15
# Interruptor de emergencia: true -> ninguna llamada al LLM real; el Safety Gate y las
# advertencias deterministicas siguen activos. Tambien existe un flag en el almacen
# (<prefijo>:llm:kill o <prefijo>:llm:groq:kill) que se activa sin redeploy.
# LLM_KILL_SWITCH=false
# Solo fuera de produccion: permite evaluar un proveedor real con contadores en memoria.
# LLM_ALLOW_LOCAL_QUOTA=true
