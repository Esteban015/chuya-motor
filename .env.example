# Chuya Motor — variables de entorno de ejemplo
# Copiá este archivo como .env.local para desarrollo local
# NUNCA commitear .env.local ni archivos con credenciales reales

# Entorno de ejecución
NODE_ENV=development

# Observabilidad (Ajuste C — DECISIONS.md)
# Nunca activar TRACE_VERBOSE=true en entornos accesibles públicamente
TRACE_VERBOSE=false

# Proveedor LLM (stub = sin llamadas reales, para demo y tests)
LLM_PROVIDER=stub
# LLM_PROVIDER=anthropic  ← activar en producción con clave real

# Clave del proveedor LLM (solo necesaria si LLM_PROVIDER != stub)
# LLM_API_KEY=sk-...

# URL base para Playwright E2E (no cambiar salvo que uses puerto diferente)
PLAYWRIGHT_BASE_URL=http://localhost:3000
